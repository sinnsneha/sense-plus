<?xml version="1.0" encoding="utf-8"?>
<!-- tokens.typography.scale: one TextAppearance per entry. Sizes already include the
     +15% accessibility uplift. Weight files are referenced directly (minSdk 26 has no
     textFontWeight). Views may override textColor. -->
<resources>

    <style name="TextAppearance.SENSE" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textColorHint">@color/ink_500</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.SENSE.DisplayNumber">
        <item name="android:textSize">56sp</item>
        <item name="android:fontFamily">@font/lexend_light</item>
        <item name="lineHeight">60sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ink_800</item>
    </style>

    <style name="TextAppearance.SENSE.DisplayNumberBold">
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">@font/lexend_extrabold</item>
        <item name="lineHeight">56sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.SENSE.HeadlineL">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="lineHeight">34sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SENSE.HeadlineM">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="lineHeight">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SENSE.TitleL">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.SENSE.TitleM">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.SENSE.TitleS">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="lineHeight">22sp</item>
    </style>

    <style name="TextAppearance.SENSE.BodyL">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="lineHeight">26sp</item>
        <item name="android:textColor">@color/ink_800</item>
    </style>

    <style name="TextAppearance.SENSE.BodyM">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textColor">@color/ink_800</item>
    </style>

    <style name="TextAppearance.SENSE.BodyS">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textColor">@color/ink_700</item>
    </style>

    <style name="TextAppearance.SENSE.LabelCaps">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="TextAppearance.SENSE.LabelButton">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- HELP: label_button at 22sp (components.emergencyButton) -->
    <style name="TextAppearance.SENSE.LabelButton.Emergency">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">26sp</item>
    </style>

    <style name="TextAppearance.SENSE.LabelButtonSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.SENSE.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/ink_500</item>
    </style>

    <style name="TextAppearance.SENSE.CaptionCaps">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:textColor">@color/ink_500</item>
    </style>

    <!-- Live captions in Hearing Assist: 26sp body (screens.hearingAssist.feed) -->
    <style name="TextAppearance.SENSE.Captions">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="lineHeight">36sp</item>
        <item name="android:textColor">@color/ink_900</item>
    </style>
</resources>
