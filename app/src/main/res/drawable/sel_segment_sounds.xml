<?xml version="1.0" encoding="utf-8"?>
<!-- components.segmentedControl segment: grad_segment_sounds when selected, clear otherwise -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_ink">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
            <corners android:radius="@dimen/radius_pill"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient android:angle="0"
                        android:startColor="@color/blush_300"
                        android:endColor="@color/tangerine_300"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
