<?xml version="1.0" encoding="utf-8"?>
<!-- components.stadiumCta: grad_cta_tangerine (top-left light → bottom-right deep), ink ripple
     for the pressed overlay; disabled = ink_100. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_ink">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ink_100"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315"
                        android:startColor="@color/grad_tangerine_mid"
                        android:centerColor="@color/tangerine_500"
                        android:endColor="@color/grad_tangerine_deep"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
