<?xml version="1.0" encoding="utf-8"?>
<!-- Communication "+ Add phrase": dashed 2dp ink_300 outline -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_ink">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
            <corners android:radius="@dimen/radius_xl"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke android:width="2dp" android:color="@color/ink_300"
                android:dashWidth="8dp" android:dashGap="6dp"/>
            <corners android:radius="@dimen/radius_xl"/>
        </shape>
    </item>
</ripple>
