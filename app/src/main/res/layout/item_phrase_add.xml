<?xml version="1.0" encoding="utf-8"?>
<!-- "+ Add phrase": dashed 2dp ink_300 outline tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_phrase"
    android:clickable="true"
    android:contentDescription="@string/comm_add_phrase_cd"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="@dimen/phrase_card_min_height"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_add"
        app:tint="@color/ink_700" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="@string/comm_add_phrase"
        android:textAppearance="@style/TextAppearance.SENSE.TitleS"
        android:textColor="@color/ink_700" />
</LinearLayout>
