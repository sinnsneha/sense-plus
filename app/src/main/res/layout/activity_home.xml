<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SENSE+" android:textSize="40sp" android:textStyle="bold" android:textColor="#1F4E79"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Choose your role" android:textSize="18sp" android:paddingBottom="40dp"/>

    <Button android:id="@+id/btnUser" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="80dp" android:text="I AM THE USER" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:backgroundTint="#1F4E79" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btnGuardian" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="80dp" android:text="I AM THE GUARDIAN" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:backgroundTint="#2E7D32"/>

</LinearLayout>