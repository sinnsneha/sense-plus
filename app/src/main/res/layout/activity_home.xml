<?xml version="1.0" encoding="utf-8"?>
<!-- screens.home: greeting → hero carousel (SENSE GUARD, Guardian) → assist tools grid.
     Card/tile backgrounds are code-drawn gradients + grain (HomeActivity.styleCards). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- top bar: avatar + greeting, Sensor Info utility button -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <FrameLayout
                android:id="@+id/avatarWrap"
                android:layout_width="@dimen/pip_avatar"
                android:layout_height="@dimen/pip_avatar"
                android:background="@drawable/bg_avatar"
                android:importantForAccessibility="noHideDescendants">

                <com.senseplus.sense.ui.DuckView
                    android:id="@+id/pipAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:duckCrop="head"
                    app:duckExpression="happy"
                    app:duckLook="home" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:focusable="true"
                android:orientation="vertical">

                <!-- role label (segment 22): "SENSE+" or "SENSE+ Guardian" -->
                <TextView
                    android:id="@+id/tvHomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.SENSE.CaptionCaps" />

                <TextView
                    android:id="@+id/tvGreetingHello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                    android:textColor="@color/ink_500" />

                <TextView
                    android:id="@+id/tvGreetingName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/home_name_fallback"
                    android:textAppearance="@style/TextAppearance.SENSE.HeadlineL" />
            </LinearLayout>

            <!-- Sensor Info is diagnostic, so it lives in a utility slot (id kept). -->
            <ImageButton
                android:id="@+id/cardSensor"
                style="@style/Widget.SENSE.CircleIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/home_sensor_cd"
                android:src="@drawable/ic_sensors" />

            <!-- Account: name, email, role, sign out (segment 22) -->
            <ImageButton
                android:id="@+id/btnAccount"
                style="@style/Widget.SENSE.CircleIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/home_account_cd"
                android:src="@drawable/ic_person" />
        </LinearLayout>

        <!-- hero carousel: card 2 peeks in from the right edge -->
        <HorizontalScrollView
            android:id="@+id/heroCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="4dp"
            android:paddingEnd="56dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/cardUser"
                    android:layout_width="@dimen/organic_card_width"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:contentDescription="@string/home_card_guard_cd"
                    android:elevation="@dimen/shadow_md"
                    android:focusable="true"
                    android:foreground="@drawable/fg_card_r36"
                    android:minHeight="@dimen/hero_card"
                    android:outlineSpotShadowColor="@color/tangerine_600">

                    <com.senseplus.sense.ui.DuckView
                        android:id="@+id/pipCardGuard"
                        android:layout_width="@dimen/pip_card"
                        android:layout_height="@dimen/pip_card"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-10dp"
                        android:layout_marginBottom="-12dp"
                        app:duckLook="guard" />

                    <TextView
                        style="@style/Widget.SENSE.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:text="@string/home_card_guard_chip" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="132dp"
                        android:layout_marginTop="56dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="72dp"
                        android:gravity="end"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/home_card_guard_title"
                            android:textAppearance="@style/TextAppearance.SENSE.TitleL" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="end"
                            android:text="@string/home_card_guard_sub"
                            android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                            android:textColor="@color/ink_800" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_glass_circle"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/ink_900" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/cardGuardian"
                    android:layout_width="@dimen/organic_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_cards"
                    android:clickable="true"
                    android:contentDescription="@string/home_card_guardian_cd"
                    android:elevation="@dimen/shadow_md"
                    android:focusable="true"
                    android:foreground="@drawable/fg_card_r36"
                    android:minHeight="@dimen/hero_card"
                    android:outlineSpotShadowColor="@color/lavender_800">

                    <com.senseplus.sense.ui.DuckView
                        android:id="@+id/pipCardGuardian"
                        android:layout_width="@dimen/pip_card"
                        android:layout_height="@dimen/pip_card"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-6dp"
                        android:layout_marginBottom="-12dp"
                        app:duckLook="guardian" />

                    <TextView
                        style="@style/Widget.SENSE.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:text="@string/home_card_guardian_chip" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="132dp"
                        android:layout_marginTop="56dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="72dp"
                        android:gravity="end"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/home_card_guardian_title"
                            android:textAppearance="@style/TextAppearance.SENSE.TitleL" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:id="@+id/tvGuardianCardSub"
                            android:gravity="end"
                            android:text="@string/home_card_guardian_sub"
                            android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                            android:textColor="@color/ink_800" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_glass_circle"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/ink_900" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- section header + Edit profile (the profile decides which tools show here) -->
        <LinearLayout
            android:id="@+id/toolsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvToolsHeader"
                    style="@style/Widget.SENSE.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tools_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tools_caption"
                    android:textAppearance="@style/TextAppearance.SENSE.Caption" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEditProfile"
                style="@style/Widget.SENSE.Button.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/home_edit_profile_cd"
                android:text="@string/home_edit_profile"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>

        <!-- tool grid (re-flows when the profile hides tools) -->
        <com.senseplus.sense.ui.TileGridLayout
            android:id="@+id/toolGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/cardComm"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/cardVisual"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/cardHearing"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/cardNavigation"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Segment 23: My guardians (user) / Link to a person (guardian). -->
            <include
                android:id="@+id/cardGuardians"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/cardLink"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Segment 26: Medical ID (user only; ModeMapper never offers it to a guardian). -->
            <include
                android:id="@+id/cardMedical"
                layout="@layout/item_tool_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.senseplus.sense.ui.TileGridLayout>
    </LinearLayout>
</ScrollView>
