<?xml version="1.0" encoding="utf-8"?>
<!-- Segment 23, guardian phone: "Link to a person". Compact mint hero with Pip in the guardian
     look → one of three states (enter code / waiting for approval / linked) → Link pinned at the
     bottom while entering a code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/linkHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/hero_compact">

                <com.senseplus.sense.ui.DuckView
                    android:id="@+id/pipLink"
                    android:layout_width="@dimen/pip_card"
                    android:layout_height="@dimen/pip_card"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp"
                    app:duckLook="guardian" />

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="44dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/top_bar_height">

                        <Button
                            android:id="@+id/btnBack"
                            style="@style/Widget.SENSE.Button.PillWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="150dp"
                        android:accessibilityHeading="true"
                        android:text="@string/link_title"
                        android:textAppearance="@style/TextAppearance.SENSE.HeadlineL" />

                    <TextView
                        android:id="@+id/tvLinkSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="150dp"
                        android:text="@string/link_sub"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                        android:textColor="@color/ink_700" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="16dp">

                <!-- State 1: enter the code -->
                <LinearLayout
                    android:id="@+id/groupEnter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCode"
                        style="@style/Widget.SENSE.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/link_code_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:letterSpacing="0.2"
                            android:maxLength="6"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        style="@style/Widget.SENSE.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/link_phone_hint"
                        app:helperText="@string/link_phone_help">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phone"
                            android:inputType="phone"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- State 2: waiting for the user to approve -->
                <LinearLayout
                    android:id="@+id/groupWaiting"
                    style="@style/Widget.SENSE.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvWaiting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.SENSE.TitleM" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/link_waiting_sub"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                        android:textColor="@color/ink_700" />

                    <Button
                        android:id="@+id/btnCancelWait"
                        style="@style/Widget.SENSE.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/link_cancel" />
                </LinearLayout>

                <!-- State 3: linked -->
                <LinearLayout
                    android:id="@+id/groupLinked"
                    style="@style/Widget.SENSE.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvLinkedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SENSE.TitleM" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/link_linked_sub"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                        android:textColor="@color/ink_700" />

                    <Button
                        android:id="@+id/btnOpenDashboard"
                        style="@style/Widget.SENSE.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/link_open_dashboard" />

                    <Button
                        android:id="@+id/btnUnlink"
                        style="@style/Widget.SENSE.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/link_unlink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLinkError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="assertive"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                    android:textColor="@color/status_emergency_text"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Link stays pinned at the bottom so it is always reachable without scrolling. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_gutter">

        <Button
            android:id="@+id/btnLink"
            style="@style/Widget.SENSE.Button.Stadium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/link_button" />
    </LinearLayout>
</LinearLayout>
