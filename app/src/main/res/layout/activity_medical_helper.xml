<?xml version="1.0" encoding="utf-8"?>
<!-- Segment 26: Medical ID "Show to a helper". READ-ONLY, very large high-contrast text, and
     the only screen in the app that is shown over the lock screen (MedicalHelperActivity).
     Nothing here can edit or send anything. The screen stays on while someone reads it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helperRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/helperScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/helperContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/top_bar_height"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    style="@style/Widget.SENSE.Button.PillWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.senseplus.sense.ui.DuckView
                    android:id="@+id/pipHelper"
                    android:layout_width="@dimen/pip_tile"
                    android:layout_height="@dimen/pip_tile"
                    app:duckLook="guard" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/medical_helper_title"
                        android:textAppearance="@style/TextAppearance.SENSE.HeadlineL"
                        android:textColor="@color/ink_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/medical_helper_sub"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                        android:textColor="@color/ink_800" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvHelperEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/medical_helper_empty"
                android:textAppearance="@style/TextAppearance.SENSE.HelperValue"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/helperRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_gutter">

        <Button
            android:id="@+id/btnReadAloud"
            style="@style/Widget.SENSE.Button.Stadium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/medical_read_aloud_cd"
            android:text="@string/medical_read_aloud" />
    </LinearLayout>
</LinearLayout>
