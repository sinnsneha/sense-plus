<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SENSE+ Safety Monitor" android:textSize="22sp" android:textStyle="bold" android:paddingBottom="12dp"/>

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Status: —" android:textSize="20sp" android:textStyle="bold" android:textColor="#1F4E79" android:paddingBottom="16dp"/>

        <Button android:id="@+id/btnHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:text="HELP" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#C62828" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnOk" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:text="I'M OK" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#2E7D32" android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/tvLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location: waiting..." android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp"/>
        <TextView android:id="@+id/tvCompass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compass: waiting..." android:textSize="16sp" android:textStyle="bold" android:paddingBottom="16dp"/>

        <TextView android:id="@+id/tvAccel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Accelerometer: waiting..." android:textSize="16sp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvGyro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gyroscope: waiting..." android:textSize="16sp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Light: waiting..." android:textSize="16sp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvProx" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proximity: waiting..." android:textSize="16sp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvSensorList" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Available sensors..." android:textSize="14sp" android:paddingTop="8dp"/>

    </LinearLayout>
</ScrollView>