<?xml version="1.0" encoding="utf-8"?>
<!-- screens.senseGuard: full hero (gradient by StatusStyle, wave edge, scallop badge, Pip in
     the guard look) → safety level → status card → HELP / I'M OK → start/stop. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/guardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- hero (height = 46% of the screen, 300–420dp; set in MainActivity) -->
        <FrameLayout
            android:id="@+id/guardHero"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_full_min">

            <com.senseplus.sense.ui.DuckView
                android:id="@+id/pipGuard"
                android:layout_width="@dimen/pip_hero"
                android:layout_height="@dimen/pip_hero"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-14dp"
                android:layout_marginBottom="10dp"
                app:duckLook="sleep" />

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:minHeight="@dimen/top_bar_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter">

                <Button
                    android:id="@+id/btnBack"
                    style="@style/Widget.SENSE.Button.PillWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvGuardTitle"
                    style="@style/Widget.SENSE.TopBarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guard_title" />
            </LinearLayout>

            <!-- scallop status badge with its medallion on the top edge -->
            <FrameLayout
                android:id="@+id/badgeWrap"
                android:layout_width="@dimen/scallop_badge"
                android:layout_height="156dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="24dp"
                android:layout_marginTop="36dp"
                android:importantForAccessibility="noHideDescendants">

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="@dimen/scallop_badge"
                    android:layout_height="@dimen/scallop_badge"
                    android:layout_gravity="bottom"
                    android:elevation="@dimen/shadow_md"
                    android:gravity="center"
                    android:maxLines="3"
                    android:outlineAmbientShadowColor="@color/tangerine_500"
                    android:outlineSpotShadowColor="@color/tangerine_600"
                    android:padding="20dp"
                    android:text="@string/guard_badge_off"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="11dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform" />

                <ImageView
                    android:id="@+id/imgBadgeMedallion"
                    android:layout_width="@dimen/scallop_medallion"
                    android:layout_height="@dimen/scallop_medallion"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_medallion"
                    android:elevation="10dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_bedtime"
                    app:tint="@color/ink_900" />
            </FrameLayout>
        </FrameLayout>

        <com.senseplus.sense.ui.WaveLevelIndicatorView
            android:id="@+id/levelIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_gutter" />

        <!-- status card -->
        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="@dimen/screen_gutter">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/status_label"
                android:textAppearance="@style/TextAppearance.SENSE.CaptionCaps" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_off"
                android:textAppearance="@style/TextAppearance.SENSE.TitleL"
                android:textColor="@color/status_off_text" />
        </LinearLayout>

        <!-- segment 25: a guardian answered "I'm on my way". Large text, hidden until then and
             again when the alert ends. It sits beside the status card: it never replaces it. -->
        <LinearLayout
            android:id="@+id/ackCard"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:backgroundTint="@color/sky_100"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/ack_card_label"
                android:textAppearance="@style/TextAppearance.SENSE.CaptionCaps"
                android:textColor="@color/sky_800" />

            <TextView
                android:id="@+id/tvAck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.SENSE.HeadlineM"
                android:textColor="@color/ink_900" />
        </LinearLayout>

        <!-- shown only when location is missing / not precise (segment 21) -->
        <Button
            android:id="@+id/btnLocationSettings"
            style="@style/Widget.SENSE.Button.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Open app settings to allow precise location"
            android:text="Location permission needed. Open settings"
            android:visibility="gone"
            app:icon="@drawable/ic_location_on" />

        <!-- HELP + I'M OK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <Button
                android:id="@+id/btnHelp"
                style="@style/Widget.SENSE.Button.Emergency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:contentDescription="@string/help_cd"
                android:text="@string/help" />

            <Button
                android:id="@+id/btnOk"
                style="@style/Widget.SENSE.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/im_ok" />
        </LinearLayout>

        <!-- segment 26: one tap to call the first guardian (or the Medical ID emergency contact) -->
        <Button
            android:id="@+id/btnCallGuardian"
            style="@style/Widget.SENSE.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="@string/call_guardian_cd"
            android:minHeight="@dimen/touch_primary"
            android:text="@string/call_guardian"
            app:icon="@drawable/ic_call" />

        <!-- THE primary action: start / stop (MainActivity sets activated while running) -->
        <Button
            android:id="@+id/btnToggle"
            style="@style/Widget.SENSE.Button.Guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:text="@string/start_monitoring" />

        <!-- a setting, not an action: a quiet text link -->
        <Button
            android:id="@+id/btnCodeword"
            style="@style/Widget.SENSE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/set_codeword" />

        <TextView
            android:id="@+id/tvFootnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:gravity="center"
            android:text="@string/guard_footnote"
            android:textAppearance="@style/TextAppearance.SENSE.Caption" />
    </LinearLayout>
</ScrollView>
