<?xml version="1.0" encoding="utf-8"?>
<!-- screens.guardian: status hero card (StatusStyle) → at a glance (battery, last update) →
     location → recent events → stop monitoring. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guardianScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/guardianContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/top_bar_height"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                style="@style/Widget.SENSE.Button.PillWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Widget.SENSE.TopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guardian_title" />
        </LinearLayout>

        <!-- status hero card (organic; gradient + Pip expression by StatusStyle) -->
        <FrameLayout
            android:id="@+id/statusHeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:elevation="@dimen/shadow_md"
            android:minHeight="@dimen/guardian_status_card_min"
            android:outlineSpotShadowColor="@color/lavender_800">

            <com.senseplus.sense.ui.DuckView
                android:id="@+id/pipGuardian"
                android:layout_width="@dimen/pip_card"
                android:layout_height="@dimen/pip_card"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-4dp"
                android:layout_marginBottom="-10dp"
                app:duckExpression="sleeping"
                app:duckLook="guardian" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="138dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="20dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGConn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_white"
                    android:drawableStart="@drawable/bg_live_dot"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/chip_height"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/guardian_checking"
                    android:textAppearance="@style/TextAppearance.SENSE.Caption"
                    android:textColor="@color/ink_900" />

                <TextView
                    android:id="@+id/tvGStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="@string/guardian_connecting"
                    android:textAppearance="@style/TextAppearance.SENSE.HeadlineM" />

                <TextView
                    android:id="@+id/tvGStatusCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                    android:textColor="@color/ink_800" />
            </LinearLayout>
        </FrameLayout>

        <!-- segment 25: "I'm on my way". GuardianActivity shows it only while the status is
             possible fall or possible emergency. It is the one primary action then. -->
        <Button
            android:id="@+id/btnAck"
            style="@style/Widget.SENSE.Button.Stadium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_cards"
            android:text="@string/guardian_ack_button"
            android:visibility="gone" />

        <!-- why the last tap did not go through; stays until the next try -->
        <TextView
            android:id="@+id/tvGAckError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="assertive"
            android:text="@string/guardian_ack_failed"
            android:textAppearance="@style/TextAppearance.SENSE.BodyM"
            android:textColor="@color/status_emergency_text"
            android:visibility="gone" />

        <TextView
            style="@style/Widget.SENSE.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_sections"
            android:text="@string/guardian_glance" />

        <!-- stat tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/guardian_battery"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                    android:textColor="@color/ink_800"
                    app:drawableStartCompat="@drawable/ic_battery"
                    app:drawableTint="@color/ink_600" />

                <com.senseplus.sense.ui.FitTextView
                    android:id="@+id/tvGBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/dash"
                    android:textAppearance="@style/TextAppearance.SENSE.DisplayNumber" />

                <!-- how old the reading is (segment 24) -->
                <TextView
                    android:id="@+id/tvGBatteryAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.SENSE.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap_cards"
                android:layout_weight="1"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/guardian_last_update"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                    android:textColor="@color/ink_800"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    app:drawableTint="@color/ink_600" />

                <com.senseplus.sense.ui.FitTextView
                    android:id="@+id/tvGUpdated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="@string/dash"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleL"
                    android:textColor="@color/ink_800" />
            </LinearLayout>
        </LinearLayout>

        <!-- location -->
        <LinearLayout
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_cards">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:text="@string/guardian_location"
                        android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                        android:textColor="@color/ink_800"
                        app:drawableStartCompat="@drawable/ic_location_on"
                        app:drawableTint="@color/coral_700" />

                    <TextView
                        android:id="@+id/tvGAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/dash"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyL"
                        android:textColor="@color/ink_900" />

                    <TextView
                        android:id="@+id/tvGCoords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/dash"
                        android:textAppearance="@style/TextAppearance.SENSE.Caption" />
                </LinearLayout>

                <!-- white card: Pip sits on a coral_100 backdrop -->
                <FrameLayout
                    android:layout_width="@dimen/pip_mini"
                    android:layout_height="@dimen/pip_mini"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_tile_circle"
                    android:backgroundTint="@color/coral_100">

                    <com.senseplus.sense.ui.DuckView
                        android:id="@+id/pipLocation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        app:duckLook="nav" />
                </FrameLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenMaps"
                style="@style/Widget.SENSE.Button.Tangerine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/guardian_open_maps"
                app:icon="@drawable/ic_map" />
        </LinearLayout>

        <!-- segment 27: safe zone around Home. The chip says where the user is; the guardian can
             switch it on, change the radius and set the home by address. Rides in the polled doc. -->
        <LinearLayout
            android:id="@+id/safeZoneCard"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_cards">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/safezone_g_title"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                    android:textColor="@color/ink_800"
                    app:drawableStartCompat="@drawable/ic_home"
                    app:drawableTint="@color/mint_700" />

                <TextView
                    android:id="@+id/tvSafeZoneChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_tile_cream_r24"
                    android:drawableStart="@drawable/bg_live_dot"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/chip_height"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/safezone_chip_no_home"
                    android:textAppearance="@style/TextAppearance.SENSE.Caption"
                    android:textColor="@color/ink_900" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSafeZoneHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/safezone_g_no_home"
                android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                android:textColor="@color/ink_800" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swGSafeZone"
                style="@style/Widget.SENSE.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/touch_min" />

            <TextView
                android:id="@+id/tvSafeZoneHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/safezone_g_need_home"
                android:textAppearance="@style/TextAppearance.SENSE.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:text="@string/safezone_size"
                android:textAppearance="@style/TextAppearance.SENSE.TitleS" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tile_cream_r24"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <Spinner
                    android:id="@+id/spGRadius"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:contentDescription="@string/safezone_size"
                    android:spinnerMode="dropdown" />
            </FrameLayout>

            <Button
                android:id="@+id/btnSetHome"
                style="@style/Widget.SENSE.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:icon="@drawable/ic_edit" />
        </LinearLayout>

        <!-- segment 26: Medical ID from users/{uid}.medical. Collapsed by default; read-only. -->
        <LinearLayout
            android:id="@+id/medicalCard"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_cards">

            <LinearLayout
                android:id="@+id/medicalHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/guardian_medical_title"
                    android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                    android:textColor="@color/ink_800"
                    app:drawableStartCompat="@drawable/ic_healing"
                    app:drawableTint="@color/coral_700" />

                <ImageView
                    android:id="@+id/medicalChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:rotation="90"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/ink_600" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/medicalBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMedicalEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/guardian_medical_empty"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                    android:textColor="@color/ink_600" />

                <LinearLayout
                    android:id="@+id/medicalRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- recent events -->
        <TextView
            style="@style/Widget.SENSE.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_sections"
            android:text="@string/guardian_events" />

        <LinearLayout
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvNoEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/guardian_no_events"
                android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                android:textColor="@color/ink_600" />

            <LinearLayout
                android:id="@+id/eventsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStop"
            style="@style/Widget.SENSE.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/guardian_stop"
            app:icon="@drawable/ic_stop" />
    </LinearLayout>
</ScrollView>
