<?xml version="1.0" encoding="utf-8"?>
<!-- screens.sensorInfo: compact sky hero (Pip sensor look) → reading tiles → sensor list. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sensorScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/sensorContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/sensorHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/hero_compact_sensor">

            <com.senseplus.sense.ui.DuckView
                android:id="@+id/pipSensor"
                android:layout_width="@dimen/pip_card"
                android:layout_height="@dimen/pip_card"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp"
                app:duckLook="sensor" />

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="44dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/top_bar_height">

                    <Button
                        android:id="@+id/btnBack"
                        style="@style/Widget.SENSE.Button.PillWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="150dp"
                    android:accessibilityHeading="true"
                    android:text="@string/sensor_title"
                    android:textAppearance="@style/TextAppearance.SENSE.HeadlineL" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="150dp"
                    android:text="@string/sensor_sub"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                    android:textColor="@color/ink_700" />
            </LinearLayout>
        </FrameLayout>

        <com.senseplus.sense.ui.TileGridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <!-- Compass (full width, decorative compass glyph) -->
            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_fullSpan="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SensorTileLabel"
                        android:text="@string/sensor_compass"
                        app:drawableStartCompat="@drawable/ic_explore" />

                    <com.senseplus.sense.ui.FitTextView
                        android:id="@+id/tvCompass"
                        style="@style/SensorTileBigValue"
                        android:text="@string/dash" />
                </LinearLayout>

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_tile_circle"
                    android:backgroundTint="@color/sky_100"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_explore"
                    app:tint="@color/sky_700" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <TextView
                    style="@style/SensorTileLabel"
                    android:text="@string/sensor_accel"
                    app:drawableStartCompat="@drawable/ic_speed" />

                <TextView
                    style="@style/SensorTileUnit"
                    android:text="@string/unit_accel" />

                <TextView
                    android:id="@+id/tvAccel"
                    style="@style/SensorTileCompactValue"
                    android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <TextView
                    style="@style/SensorTileLabel"
                    android:text="@string/sensor_gyro"
                    app:drawableStartCompat="@drawable/ic_screen_rotation" />

                <TextView
                    style="@style/SensorTileUnit"
                    android:text="@string/unit_gyro" />

                <TextView
                    android:id="@+id/tvGyro"
                    style="@style/SensorTileCompactValue"
                    android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <TextView
                    style="@style/SensorTileLabel"
                    android:text="@string/sensor_light"
                    app:drawableStartCompat="@drawable/ic_light_mode" />

                <com.senseplus.sense.ui.FitTextView
                    android:id="@+id/tvLight"
                    style="@style/SensorTileBigValue"
                    android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.SENSE.StatTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <TextView
                    style="@style/SensorTileLabel"
                    android:text="@string/sensor_prox"
                    app:drawableStartCompat="@drawable/ic_sensors" />

                <com.senseplus.sense.ui.FitTextView
                    android:id="@+id/tvProx"
                    style="@style/SensorTileBigValue"
                    android:text="@string/dash" />
            </LinearLayout>
        </com.senseplus.sense.ui.TileGridLayout>

        <TextView
            style="@style/Widget.SENSE.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/gap_sections"
            android:text="@string/sensor_list_header" />

        <LinearLayout
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter">

            <TextView
                android:id="@+id/tvSensorList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="@string/dash"
                android:textAppearance="@style/TextAppearance.SENSE.BodyM" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
