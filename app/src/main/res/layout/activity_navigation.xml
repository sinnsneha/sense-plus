<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/header_gradient"
        android:paddingTop="44dp" android:paddingBottom="22dp"
        android:paddingStart="24dp" android:paddingEnd="24dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_navigation"
            android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Navigate Home" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Arrow and spoken directions back to Home" android:textSize="14sp"
            android:textColor="#CFE0F5"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/tvNavStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Finding your location…" android:textSize="22sp"
                android:textStyle="bold" android:textColor="@color/blue"
                android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/navCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/card_white" android:elevation="3dp"
                android:padding="20dp" android:layout_marginBottom="14dp">

                <ImageView android:id="@+id/imgArrow"
                    android:layout_width="160dp" android:layout_height="160dp"
                    android:src="@drawable/ic_navigation" android:tint="@color/nav"
                    android:padding="24dp"
                    android:contentDescription="Directions to Home"/>

                <TextView android:id="@+id/tvHomeInfo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Home saved at —" android:textSize="13sp"
                    android:textColor="@color/text_muted" android:layout_marginTop="8dp"/>

                <TextView android:id="@+id/tvCalibration"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Compass needs calibration: move the phone in a figure 8"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/orange" android:gravity="center"
                    android:layout_marginTop="12dp" android:visibility="gone"/>
            </LinearLayout>

            <TextView android:id="@+id/tvNoHome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No Home saved yet. Stand where you want Home to be, wait for a good GPS fix, then tap Save this place as Home."
                android:textSize="16sp" android:textColor="@color/text_dark"
                android:background="@drawable/card_white" android:elevation="3dp"
                android:padding="20dp" android:layout_marginBottom="14dp"
                android:visibility="gone"/>

            <Button android:id="@+id/btnSaveHome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:text="Save this place as Home"
                android:textSize="18sp" android:textAllCaps="false"
                android:textColor="@color/white" android:backgroundTint="@color/nav"
                android:layout_marginBottom="12dp"/>

            <Button android:id="@+id/btnSpeak"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:text="Speak directions"
                android:textSize="18sp" android:textAllCaps="false"
                android:textColor="@color/white" android:backgroundTint="@color/blue"
                android:layout_marginBottom="12dp"/>

            <Switch android:id="@+id/switchAutoSpeak"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:text="Auto-speak every 10 s"
                android:textSize="16sp" android:textColor="@color/text_dark"
                android:gravity="center_vertical" android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/card_white" android:elevation="3dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
