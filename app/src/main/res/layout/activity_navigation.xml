<?xml version="1.0" encoding="utf-8"?>
<!-- screens.navigation: compact coral hero (Pip nav look) → status + GPS accuracy → compass
     dial card with distance → fixes for location problems → Save Home (primary) → type an
     address → walking directions → speak directions → auto-speak. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/navContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/navHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/hero_compact">

            <com.senseplus.sense.ui.DuckView
                android:id="@+id/pipNav"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                app:duckLook="nav" />

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="44dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/top_bar_height">

                    <Button
                        android:id="@+id/btnBack"
                        style="@style/Widget.SENSE.Button.PillWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="150dp"
                    android:accessibilityHeading="true"
                    android:text="@string/nav_title"
                    android:textAppearance="@style/TextAppearance.SENSE.HeadlineL" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="150dp"
                    android:text="@string/nav_sub"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                    android:textColor="@color/ink_700" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvNavStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:text="@string/nav_finding"
            android:textAppearance="@style/TextAppearance.SENSE.TitleL" />

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:drawablePadding="6dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:text="@string/nav_no_fix"
            android:textAppearance="@style/TextAppearance.SENSE.Caption"
            app:drawableStartCompat="@drawable/ic_location_on"
            app:drawableTint="@color/ink_500" />

        <!-- compass card -->
        <LinearLayout
            android:id="@+id/navCard"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:background="@drawable/bg_card_white_r32"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/nav_distance_label"
                android:textAppearance="@style/TextAppearance.SENSE.CaptionCaps" />

            <com.senseplus.sense.ui.FitTextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/dash"
                android:textAppearance="@style/TextAppearance.SENSE.DisplayNumber" />

            <FrameLayout
                android:layout_width="@dimen/compass_dial"
                android:layout_height="@dimen/compass_dial"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_compass_dial">

                <ImageView
                    android:id="@+id/imgArrow"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_arrow_cd"
                    android:padding="16dp"
                    android:src="@drawable/ic_navigation"
                    app:tint="@color/coral_700" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHomeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SENSE.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/nav_hold_hint"
                android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                android:textColor="@color/ink_600" />

            <TextView
                android:id="@+id/tvCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_listening_chip_error"
                android:backgroundTint="@color/status_attention_tint"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/nav_calibrate"
                android:textAppearance="@style/TextAppearance.SENSE.TitleS"
                android:textColor="@color/status_attention_text"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoHome"
            style="@style/Widget.SENSE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:text="@string/nav_no_home"
            android:textAppearance="@style/TextAppearance.SENSE.BodyL"
            android:textColor="@color/ink_900"
            android:visibility="gone" />

        <!-- location problems: one of these shows when it can fix the status line -->
        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.SENSE.Button.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Open app settings to allow precise location"
            android:text="@string/nav_open_settings"
            android:visibility="gone"
            app:icon="@drawable/ic_settings" />

        <Button
            android:id="@+id/btnRetryLocation"
            style="@style/Widget.SENSE.Button.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Turn on location and try again"
            android:text="@string/nav_turn_on_location"
            android:visibility="gone"
            app:icon="@drawable/ic_location_on" />

        <Button
            android:id="@+id/btnSaveHome"
            style="@style/Widget.SENSE.Button.Stadium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Save this place as Home"
            android:text="@string/nav_save_home"
            app:icon="@drawable/ic_cta_home" />

        <Button
            android:id="@+id/btnTypeAddress"
            style="@style/Widget.SENSE.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Type your home address instead of using GPS"
            android:text="@string/nav_type_address"
            app:icon="@drawable/ic_edit" />

        <Button
            android:id="@+id/btnWalkingDirections"
            style="@style/Widget.SENSE.Button.Tangerine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Open Google Maps walking directions to Home"
            android:text="@string/nav_walking"
            android:visibility="gone"
            app:icon="@drawable/ic_map" />

        <Button
            android:id="@+id/btnSpeak"
            style="@style/Widget.SENSE.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:contentDescription="Speak directions to Home"
            android:text="@string/nav_speak"
            app:icon="@drawable/ic_volume_up" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:background="@drawable/bg_card_white_r24"
            android:elevation="@dimen/shadow_xs"
            android:minHeight="64dp"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="@string/nav_auto_speak" />
    </LinearLayout>
</ScrollView>
