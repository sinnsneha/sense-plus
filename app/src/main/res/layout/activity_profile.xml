<?xml version="1.0" encoding="utf-8"?>
<!-- screens.profileSettings: compact lavender hero with Pip in the profile look (bow tie +
     flower, from the sticker sheet) → assistance-mode cards, each showing Pip in the look of
     the tool it adds → Save (pinned, always reachable). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/profileHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/hero_compact">

                <com.senseplus.sense.ui.DuckView
                    android:id="@+id/pipProfile"
                    android:layout_width="@dimen/pip_card"
                    android:layout_height="@dimen/pip_card"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp"
                    app:duckLook="profile" />

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="44dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/top_bar_height">

                        <Button
                            android:id="@+id/btnBack"
                            style="@style/Widget.SENSE.Button.PillWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="150dp"
                        android:accessibilityHeading="true"
                        android:text="@string/profile_title"
                        android:textAppearance="@style/TextAppearance.SENSE.HeadlineL" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="150dp"
                        android:text="@string/profile_sub"
                        android:textAppearance="@style/TextAppearance.SENSE.BodyM"
                        android:textColor="@color/ink_700" />
                </LinearLayout>
            </FrameLayout>

            <!-- Each row is ONE CheckBox (framework class): the first line is the label, the
                 second the explanation. TalkBack reads both as the checkbox's name, and the
                 whole card is the touch target. Pip is set as the start drawable in Java. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="8dp">

                <android.widget.CheckBox
                    android:id="@+id/cbVisual"
                    style="@style/Widget.SENSE.ProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_seeing" />

                <android.widget.CheckBox
                    android:id="@+id/cbHearing"
                    style="@style/Widget.SENSE.ProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_hearing" />

                <android.widget.CheckBox
                    android:id="@+id/cbCommunication"
                    style="@style/Widget.SENSE.ProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_speaking" />

                <android.widget.CheckBox
                    android:id="@+id/cbMobility"
                    style="@style/Widget.SENSE.ProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_moving" />

                <android.widget.CheckBox
                    android:id="@+id/cbCognitive"
                    style="@style/Widget.SENSE.ProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_remembering" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/profile_hint"
                    android:textAppearance="@style/TextAppearance.SENSE.BodyS"
                    android:textColor="@color/ink_600" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Save stays pinned at the bottom so it is always reachable without scrolling. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_gutter">

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.SENSE.Button.Stadium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_save" />
    </LinearLayout>
</LinearLayout>
