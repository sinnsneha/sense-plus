<?xml version="1.0" encoding="utf-8"?>
<!-- Lexend (SIL OFL 1.1, see design/licenses/Lexend-OFL.txt). Static instances generated
     from Google Fonts' variable Lexend[wght].ttf. The family lets android:textStyle="bold"
     pick the real Bold file; TextAppearance styles reference weight files directly. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:fontStyle="normal" android:fontWeight="300" android:font="@font/lexend_light"
        app:fontStyle="normal" app:fontWeight="300" app:font="@font/lexend_light"/>
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/lexend_regular"
        app:fontStyle="normal" app:fontWeight="400" app:font="@font/lexend_regular"/>
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/lexend_medium"
        app:fontStyle="normal" app:fontWeight="500" app:font="@font/lexend_medium"/>
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/lexend_semibold"
        app:fontStyle="normal" app:fontWeight="600" app:font="@font/lexend_semibold"/>
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/lexend_bold"
        app:fontStyle="normal" app:fontWeight="700" app:font="@font/lexend_bold"/>
    <font android:fontStyle="normal" android:fontWeight="800" android:font="@font/lexend_extrabold"
        app:fontStyle="normal" app:fontWeight="800" app:font="@font/lexend_extrabold"/>
</font-family>
