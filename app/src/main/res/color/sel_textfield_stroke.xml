<?xml version="1.0" encoding="utf-8"?>
<!-- Text field outline: ≥ 3:1 at rest (ink_500), lavender_600 when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ink_300" android:state_enabled="false"/>
    <item android:color="@color/lavender_600" android:state_focused="true"/>
    <item android:color="@color/ink_700" android:state_hovered="true"/>
    <item android:color="@color/ink_500"/>
</selector>
